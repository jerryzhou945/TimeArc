# Auto-detect text files and normalize line endings to LF.
* text=auto eol=lf

# Source files
*.c      text eol=lf
*.cpp    text eol=lf
*.h      text eol=lf
*.hpp    text eol=lf
*.qml    text eol=lf
*.js     text eol=lf
*.qrc    text eol=lf
*.ui     text eol=lf
*.cmake  text eol=lf
CMakeLists.txt text eol=lf
*.txt    text eol=lf
*.txt.user text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.yaml   text eol=lf
*.yml    text eol=lf
*.xml    text eol=lf
*.pro    text eol=lf
*.pri    text eol=lf
*.pro.user text eol=lf
*.ts     text eol=lf
*.sh     text eol=lf
*.csh    text eol=lf
*.bat    text eol=crlf

# Images and other binaries
*.svg    text eol=lf
*.qm     binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.icns   binary
*.ttf    binary
*.otf    binary
*.woff   binary
*.woff2  binary
