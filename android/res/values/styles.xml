<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TimeArcAppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorAccent">@color/timearc_accent</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:navigationBarColor">@color/timearc_launch_background</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowBackground">@drawable/timearc_launch_background</item>
    </style>

    <style name="TimeArcLaunchTheme" parent="TimeArcAppTheme">
        <item name="android:windowBackground">@drawable/timearc_launch_background</item>
    </style>
</resources>
